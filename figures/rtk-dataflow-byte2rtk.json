  "stages": [
    { "label": "二进制输入" },
    { "label": "字节缓冲" },
    { "label": "帧提取" },
    { "label": "数据解码" },
    { "label": "配对与 RTK" }
  ],
  "nodes": [
    { "id": "bas-bin", "type": "external", "label": "基站二进制流", "sublabel": "OEM7 *.bin ｜ TCP 裸字节", "stage": 0, "row": 0, "tag": "fread / recv" },
    { "id": "rov-bin", "type": "external", "label": "流动站二进制流", "sublabel": "OEM7 *.bin ｜ TCP 裸字节", "stage": 0, "row": 3, "tag": "fread / recv" },

    { "id": "bas-buf", "type": "frontend", "label": "BasDec 字节缓冲", "sublabel": "Buff[40960] · Len 追加", "stage": 1, "row": 0, "width": 150, "tag": "nSyncLoss++ · 半帧保留" },
    { "id": "rov-buf", "type": "frontend", "label": "RovDec 字节缓冲", "sublabel": "Buff[40960] · Len 追加", "stage": 1, "row": 3, "width": 150, "tag": "实时 select 100ms" },

    { "id": "frm-frame", "type": "backend", "label": "帧定位与长度", "sublabel": "0xAA 44 12 · frameLen 校验", "stage": 2, "row": 0, "width": 140, "tag": "读 Buff、Len" },
    { "id": "frm-crc", "type": "backend", "label": "CRC32 校验", "sublabel": "帧尾 4B 比对", "stage": 2, "row": 1, "width": 150, "tag": "失败滑动 1 字节" },
    { "id": "frm-disp", "type": "backend", "label": "按 MsgId 分发", "sublabel": "42 / 43 / 7 / 1696", "stage": 2, "row": 3, "width": 140, "tag": "memmove · Len=remain" },

    { "id": "dec-obs", "type": "database", "label": "观测历元 EPOCHOBS", "sublabel": "Time · P/L/D[2] · cn0 · SatNum", "stage": 3, "row": 1, "width": 140, "tag": "44B/条 · nRange++" },
    { "id": "dec-aux", "type": "database", "label": "坐标与星历数据", "sublabel": "rb 坐标 · GpsEph / BdsEph", "stage": 3, "row": 3, "width": 140, "tag": "42/7/1696 · 计数++" },

    { "id": "rawdat", "type": "database", "label": "RAWDAT 对齐历元", "sublabel": "BasEpk+RovEpk+星历+BasPos", "stage": 4, "row": 0, "width": 145, "tag": "BasPosValid=true" },
    { "id": "sync", "type": "backend", "label": "GetSynGNSSObs 配对", "sublabel": "dt=GetDiffTime(Rov−Bas) 跨周", "stage": 4, "row": 1, "width": 165, "tag": "文件 0.5s·实时 5s" },
    { "id": "rtk", "type": "cloud", "label": "RTK 解算（未实现）", "sublabel": "单差→周跳→双差→浮点→LAMBDA", "stage": 4, "row": 3, "width": 165, "tag": "固定解 / 浮点解" }
  ],
  "flows": [
    { "id": "bas-feed", "from": "bas-bin", "to": "bas-buf", "label": "原始字节", "classification": "二进制 · 无文本解析", "variant": "emphasis", "labelAt": [208, 200] },
    { "id": "rov-feed", "from": "rov-bin", "to": "rov-buf", "label": "原始字节", "classification": "二进制 · 无文本解析", "variant": "default", "labelAt": [208, 542] },

    { "id": "bas-parse", "from": "bas-buf", "to": "frm-frame", "label": "FeedNovData", "classification": "追加缓冲", "variant": "emphasis", "route": "straight", "fromSide": "right", "toSide": "left", "labelAt": [370, 250] },
    { "id": "rov-parse", "from": "rov-buf", "to": "frm-frame", "label": "FeedNovData", "classification": "追加缓冲", "variant": "default", "labelAt": [370, 330] },

    { "id": "frame-crc", "from": "frm-frame", "to": "frm-crc", "label": "完整帧", "classification": "frameLen 通过", "variant": "emphasis", "route": "straight", "fromSide": "bottom", "toSide": "top", "labelAt": [480, 214] },
    { "id": "crc-disp", "from": "frm-crc", "to": "frm-disp", "label": "有效帧", "classification": "CRC32 通过", "variant": "emphasis", "route": "straight", "fromSide": "bottom", "toSide": "top", "labelAt": [530, 385] },

    { "id": "disp-obs", "from": "frm-disp", "to": "dec-obs", "label": "MsgId 43", "classification": "RANGEB", "variant": "emphasis", "labelAt": [610, 214] },
    { "id": "disp-aux", "from": "frm-disp", "to": "dec-aux", "label": "42 / 7 / 1696", "classification": "BESTPOS / 星历", "variant": "default", "labelAt": [585, 430] },

    { "id": "obs-sync", "from": "dec-obs", "to": "sync", "label": "BasEpk / RovEpk", "classification": "观测历元就绪", "variant": "emphasis", "route": "straight", "fromSide": "right", "toSide": "left", "labelAt": [820, 225] },
    { "id": "aux-sync", "from": "dec-aux", "to": "sync", "label": "rb + 星历", "classification": "随历元打包", "variant": "default", "fromSide": "right", "toSide": "bottom", "via": [[865, 499], [865, 320], [960, 320]], "labelAt": [800, 320] },

    { "id": "sync-raw", "from": "sync", "to": "rawdat", "label": "配对成功", "classification": "|dt| ≤ 阈值", "variant": "emphasis", "route": "straight", "fromSide": "top", "toSide": "bottom", "labelAt": [1000, 214] },
    { "id": "raw-rtk", "from": "rawdat", "to": "rtk", "label": "逐历元 RAWDAT", "classification": "下游接口", "variant": "dashed", "fromSide": "right", "toSide": "right", "via": [[1054, 157], [1054, 499]], "labelAt": [1010, 365] }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "二进制 → 帧",
      "items": [
        "OEM7 二进制：0xAA 44 12 同步头 + 28B 头 + 消息体 + 4B CRC32",
        "RANGEB 每条观测记录 44 字节（P/L/D/cn0/Lock）",
        "切帧失败滑动 1 字节；不足一帧保留半帧（nBadCrc/nSyncLoss）"
      ]
    },
    {
      "dot": "cyan",
      "title": "帧 → 结构体",
      "items": [
        "42 → PPRESULT（sol_status，BLH→XYZ WGS84）",
        "43 → EPOCHOBS（毫秒→秒；GPS L1/L2、BDS B1/B3）",
        "7 / 1696 → GpsEph[32] / BdsEph[63] 广播星历"
      ]
    },
    {
      "dot": "amber",
      "title": "结构体 → RTK",
      "items": [
        "GetSynGNSSObs 按 GPS 时间配对（跨周处理）",
        "文件 0.5 s / 实时 5 s；流动站早→丢、晚→追基站",
        "RAWDAT 逐历元交下游（单差→…→LAMBDA，未实现）"
      ]
    }
  ]
}
