<mxfile host="app.diagrams.net">
  <diagram id="rtk-dataflow" name="RTK数据流程">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="2230" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="RTK 数据处理流程图（当前代码实现：双流解码 + 时间配对）" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="10" width="800" height="32" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="颜色说明&#10;灰：数据源　蓝：流处理&#10;紫：共用解码核心　绿：数据结构&#10;橙：时间配对　黄：判定&#10;虚线橙：已声明未实现" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1100" y="60" width="440" height="120" as="geometry" />
        </mxCell>

        <mxCell id="n_start" value="开始：程序启动" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="70" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n_mode" value="选择输入模式&#10;2 = RTK 文件模式（基站 / 流动站 *.bin）&#10;3 = RTK 实时模式（基站 / 流动站 TCP）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="440" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n_open" value="打开两条数据流：基站 + 流动站" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="440" height="48" as="geometry" />
        </mxCell>

        <mxCell id="n_bsrc" value="基站数据源&#10;文件 fread ｜ TCP recv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="320" width="360" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n_rsrc" value="流动站数据源&#10;文件 fread ｜ TCP recv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="320" width="360" height="56" as="geometry" />
        </mxCell>

        <mxCell id="n_bbuf" value="BasDec（NOVDECODER）&#10;基站流独立缓冲区&#10;半帧状态 / 统计计数独立" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="420" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n_rbuf" value="RovDec（NOVDECODER）&#10;流动站流独立缓冲区&#10;半帧状态 / 统计计数独立" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="420" width="360" height="64" as="geometry" />
        </mxCell>

        <mxCell id="n_bpump" value="PumpStream（基站）&#10;读块 → FeedNovData 追加缓冲&#10;缓冲满 → 清空重同步（nSyncLoss++）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="530" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n_rpump" value="PumpStream（流动站）&#10;读块 → FeedNovData 追加缓冲&#10;缓冲满 → 清空重同步（nSyncLoss++）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="530" width="360" height="72" as="geometry" />
        </mxCell>

        <mxCell id="n_core" value="DecodeNovStream → ParseNovMsg（共用解码核心）&#10;同步头 0xAA 44 12 → 帧长校验 → CRC32 校验&#10;按 MsgId 分发；不完整帧保留半帧&#10;CRC 失败：nBadCrc++，滑动 1 字节重找同步头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="670" width="440" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n_d0" value="本流解出 RANGEB？&#10;（MsgId = 43）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="800" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n_bepk" value="BasEpk 基站观测历元&#10;EPOCHOBS（MsgId 43）&#10;基站流输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="930" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n_eph" value="GpsEph / BdsEph&#10;广播星历（MsgId 7 / 1696）&#10;两流共用同一组星历" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="930" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n_repk" value="RovEpk 流动站观测历元&#10;EPOCHOBS（MsgId 43）&#10;流动站流输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1170" y="930" width="300" height="64" as="geometry" />
        </mxCell>

        <mxCell id="n_sync" value="GetSynGNSSObs 时间配对（PairEpoch）&#10;dt = GetDiffTime(流动站 − 基站)，含跨周处理&#10;阈值：文件 0.5 s ｜ 实时 5 s（select 等待）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1100" width="440" height="72" as="geometry" />
        </mxCell>

        <mxCell id="n_d1" value="|dt| ≤ 阈值？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="1195" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n_readbase" value="读基站历元（PumpStream 基站）&#10;捕获首个 BESTPOS → BasPos&#10;读后重新配对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="1195" width="320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n_discard" value="丢弃该流动站历元&#10;取下一个流动站历元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1195" width="320" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n_tend" value="基站 EOF / 断连：RTK 处理结束" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="1355" width="340" height="48" as="geometry" />
        </mxCell>

        <mxCell id="n_bpos" value="BasPos 基准站坐标 rb&#10;首个有效 BESTPOS（MsgId 42）&#10;仅基站流传入 pos 指针" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="1443" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n_rawdat" value="RAWDAT（同步历元数据）&#10;BasEpk + RovEpk + 星历 + BasPos&#10;逐历元交下游解算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="1440" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n_plan" value="下游 RTK 解算链（RTK_Structs.h 已声明，当前未实现 / 未接入主流程）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=8;fillColor=#fdf7ef;strokeColor=#d79b00;dashed=1;fontSize=12;fontColor=#B46504;" vertex="1" parent="1">
          <mxGeometry x="420" y="1580" width="1120" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n_p1" value="FormSDEpochObs&#10;单差观测（SDEPOCHOBS）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="445" y="1645" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_p2" value="DetectCycleSlip&#10;周跳探测（MW / GF）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="655" y="1645" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_p3" value="DetRefSat&#10;参考星选择 + 双差 DDCOBS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="865" y="1645" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_p4" value="RTKFloat&#10;浮点解（RTKEKF 滤波）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1075" y="1645" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n_p5" value="lambda / LAMBDA&#10;模糊度固定 → 固定解 / 浮点解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1285" y="1645" width="190" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;共用解码核心（Decoding.cpp）&lt;/b&gt;&#10;• ParseNovMsg：同步头 0xAA 44 12 → 帧长与 CRC32 校验 → 按 MsgId 分发&#10;• MsgId：42 BESTPOS ｜ 43 RANGEB ｜ 7 GPSEPHEM ｜ 1696 BDSEPHEMERIS&#10;• 不完整帧：尾部字节前移保留（半帧拼接）；CRC 失败：nBadCrc++ 并滑动 1 字节&#10;• 旧入口 DecodeNovOem7Dat 为薄封装，SPP 单流路径复用同一解码代码" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fillColor=#f9f9f9;strokeColor=#b3b3b3;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="1760" width="680" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;双流缓冲与泵浦（Data_IO.cpp）&lt;/b&gt;&#10;• BasDec / RovDec 各持一份 NOVDECODER：缓冲区、半帧状态、统计计数互不影响&#10;• PumpStream：读块 → FeedNovData → 循环 DecodeNovStream 直到本流解出 RANGEB（返回 1）&#10;• 读失败 / EOF 返回 −1；无 RANGEB 返回 0；基站流捕获首个有效 BESTPOS 为 rb&#10;• 两流共用同一套解析代码，仅持有状态不同" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fillColor=#f9f9f9;strokeColor=#b3b3b3;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="1760" width="680" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;时间配对规则（GetSynGNSSObs / PairEpoch）&lt;/b&gt;&#10;• dt = Δ周 × 604800 + Δ周内秒（GetDiffTime，已处理跨周）&#10;• 文件模式阈值 0.5 s；实时模式 5 s，先用 select() 等待流动站，空闲时吸收基站数据&#10;• 流动站早（dt &lt; 0）→ 丢弃该历元；流动站晚 / 基站未到 → 继续读基站；基站 EOF / 断连 → RTK 结束" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fillColor=#f9f9f9;strokeColor=#b3b3b3;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="1990" width="680" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;下游解算与接入状态&lt;/b&gt;&#10;• 已声明未实现（RTK_Structs.h）：FormSDEpochObs、DetectCycleSlip、DetRefSat、RTKFloat、（LAMBDA）&#10;• main.cpp 目前仅接入模式 0 / 1 的 SPP 通路；模式 2 / 3 的 RTK 数据通路已实现但尚未在 main 中调用&#10;• ReadRTKConfigInfo() 目前为占位实现（仅打开配置文件）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=10;fillColor=#f9f9f9;strokeColor=#b3b3b3;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="1990" width="680" height="210" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_start" target="n_mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_mode" target="n_open">
