        <mxCell id="e25" value="是：|dt| ≤ 阈值，配对成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_d1" target="n_rawdat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_bpos" target="n_rawdat">
          <mxGeometry relative="1" as="geometry" />
