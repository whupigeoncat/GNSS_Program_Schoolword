        <mxCell id="e13" value="MsgId 7 / 1696（两流共用）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_core" target="n_eph">
          <mxGeometry relative="1" as="geometry">
