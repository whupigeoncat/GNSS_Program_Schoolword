        </mxCell>

        <mxCell id="e15" value="否：继续取帧解码（无完整帧则再读数据）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_d0" target="n_core">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="780" />
              <mxPoint x="900" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" value="是：该流历元就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_d0" target="n_sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e17" value="基站历元" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_bepk" target="n_sync">
          <mxGeometry relative="1" as="geometry">
