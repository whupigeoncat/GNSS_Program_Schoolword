        </mxCell>

        <mxCell id="e20" value="否 · 流动站晚 / 基站未到" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_d1" target="n_readbase">
          <mxGeometry relative="1" as="geometry">
