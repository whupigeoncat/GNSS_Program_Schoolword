        <mxCell id="e14" value="MsgId 42（仅基站流）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="n_core" target="n_bpos">
          <mxGeometry relative="1" as="geometry">
