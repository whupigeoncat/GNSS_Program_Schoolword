        <mxCell id="e21" value="重新配对（循环）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_readbase" target="n_d1">
          <mxGeometry relative="1" as="geometry">
