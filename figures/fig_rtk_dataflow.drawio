        </mxCell>
        <mxCell id="e12" value="MsgId 43（流动站流）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_core" target="n_repk">
          <mxGeometry relative="1" as="geometry">
