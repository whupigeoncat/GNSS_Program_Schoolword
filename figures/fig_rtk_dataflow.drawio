        </mxCell>
        <mxCell id="e22" value="EOF / 断连" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_readbase" target="n_tend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" value="否 · 流动站早（dt &lt; 0）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_d1" target="n_discard">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="980" y="1245" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e24" value="下一个流动站历元" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_discard" target="n_rpump">
          <mxGeometry relative="1" as="geometry">
