            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_rpump" target="n_core">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1020" y="566" />
              <mxPoint x="1020" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e11" value="MsgId 43（基站流）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="n_core" target="n_bepk">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="240" y="705" />
